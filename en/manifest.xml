<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<OfficeApp xmlns="http://schemas.microsoft.com/office/appforoffice/1.1" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0" xmlns:ov="http://schemas.microsoft.com/office/taskpaneappversionoverrides" xsi:type="TaskPaneApp">
  <Id>25bfe623-d1d7-4b1b-842e-8bd1a4e399b0</Id>
  <Version>2.0.0.0</Version>
  <ProviderName>Shaza Add-ins</ProviderName>
  <DefaultLocale>en-US</DefaultLocale>
  <DisplayName DefaultValue="Shaza Toolkit"/>
  <Description DefaultValue="Insert, recolour and frame your own SVG icon library directly on PowerPoint slides — theme-aware, fully offline, vector output."/>
  <IconUrl DefaultValue="https://engshaza2025.github.io/pptxLibrary_byshaza/assets/icon-32.png"/>
  <HighResolutionIconUrl DefaultValue="https://engshaza2025.github.io/pptxLibrary_byshaza/assets/icon-64.png"/>
  <SupportUrl DefaultValue="https://engshaza2025.github.io/pptxLibrary_byshaza/en/support.html"/>
  <AppDomains>
    <AppDomain>https://engshaza2025.github.io</AppDomain>
  </AppDomains>
  <Hosts>
    <Host Name="Presentation"/>
  </Hosts>
  <Requirements>
    <Sets DefaultMinVersion="1.1">
      <Set Name="ImageCoercion" MinVersion="1.2"/>
    </Sets>
  </Requirements>
  <DefaultSettings>
    <SourceLocation DefaultValue="https://engshaza2025.github.io/pptxLibrary_byshaza/en/"/>
  </DefaultSettings>
  <Permissions>ReadWriteDocument</Permissions>
  <VersionOverrides xmlns="http://schemas.microsoft.com/office/taskpaneappversionoverrides" xsi:type="VersionOverridesV1_0">
    <Hosts>
      <Host xsi:type="Presentation">
        <DesktopFormFactor>
          <GetStarted>
            <Title resid="GetStarted.Title"/>
            <Description resid="GetStarted.Description"/>
            <LearnMoreUrl resid="GetStarted.LearnMoreUrl"/>
          </GetStarted>
          <FunctionFile resid="Commands.Url"/>
          <ExtensionPoint xsi:type="PrimaryCommandSurface">
            <OfficeTab id="TabHome">
              <Group id="CommandsGroup">
                <Label resid="CommandsGroup.Label"/>
                <Icon>
                  <bt:Image size="16" resid="Icon.16x16"/>
                  <bt:Image size="32" resid="Icon.32x32"/>
                  <bt:Image size="80" resid="Icon.80x80"/>
                </Icon>
                <Control xsi:type="Button" id="TaskpaneButton">
                  <Label resid="TaskpaneButton.Label"/>
                  <Supertip>
                    <Title resid="TaskpaneButton.Label"/>
                    <Description resid="TaskpaneButton.Tooltip"/>
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon.16x16"/>
                    <bt:Image size="32" resid="Icon.32x32"/>
                    <bt:Image size="80" resid="Icon.80x80"/>
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <TaskpaneId>ButtonId1</TaskpaneId>
                    <SourceLocation resid="Taskpane.Url"/>
                  </Action>
                </Control>
              </Group>
            </OfficeTab>
          </ExtensionPoint>
        </DesktopFormFactor>
      </Host>
    </Hosts>
    <Resources>
      <bt:Images>
        <bt:Image id="Icon.16x16" DefaultValue="https://engshaza2025.github.io/pptxLibrary_byshaza/assets/icon-16.png"/>
        <bt:Image id="Icon.32x32" DefaultValue="https://engshaza2025.github.io/pptxLibrary_byshaza/assets/icon-32.png"/>
        <bt:Image id="Icon.80x80" DefaultValue="https://engshaza2025.github.io/pptxLibrary_byshaza/assets/icon-80.png"/>
      </bt:Images>
      <bt:Urls>
        <bt:Url id="GetStarted.LearnMoreUrl" DefaultValue="https://engshaza2025.github.io/pptxLibrary_byshaza/en/"/>
        <bt:Url id="Commands.Url" DefaultValue="https://engshaza2025.github.io/pptxLibrary_byshaza/en/"/>
        <bt:Url id="Taskpane.Url" DefaultValue="https://engshaza2025.github.io/pptxLibrary_byshaza/en/"/>
      </bt:Urls>
      <bt:ShortStrings>
        <bt:String id="GetStarted.Title" DefaultValue="Shaza Toolkit is ready"/>
        <bt:String id="CommandsGroup.Label" DefaultValue="Shaza Icons"/>
        <bt:String id="TaskpaneButton.Label" DefaultValue="Open Library"/>
      </bt:ShortStrings>
      <bt:LongStrings>
        <bt:String id="GetStarted.Description" DefaultValue="Your icon library is ready. Point it at a folder of SVG files, then insert them as theme-coloured vector objects. Click 'Open Library' on the Home tab."/>
        <bt:String id="TaskpaneButton.Tooltip" DefaultValue="Open the SVG icon library pane"/>
      </bt:LongStrings>
    </Resources>
  </VersionOverrides>
</OfficeApp>
